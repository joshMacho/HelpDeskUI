{
  "type": "object",
  "sections": [
    {
      "name": "policyInfo",
      "label": "POLICY DETAILS",
      "fields": [
        {
          "type": "group",
          "name": "policyInfo",
          "label": "Policy Details",
          "fields": [
            {
              "type": "select",
              "name": "currency",
              "label": "Currency",
              "validation": {
                "required": "Currency is required"
              },
              "options": [
                { "label": "GHC", "value": "GHC" },
                { "label": "EUR", "value": "EUR" },
                { "label": "USD", "value": "USD" },
                { "label": "GBP", "value": "GBP" }
              ]
            },
            {
              "type": "date",
              "name": "startDate",
              "label": "Start Date",
              "minDate": "today",
              "validation": {
                "required": "Enter/Select a start date"
              }
            },
            {
              "type": "select",
              "name": "period",
              "label": "Period",
              "validation": {
                "required": "Select a period"
              },
              "options": [
                { "label": "1 Month", "value": "1 Month" },
                { "label": "2 Months", "value": "2 Months" },
                { "label": "3 Months", "value": "3 Months" },
                { "label": "4 Months", "value": "4 Months" },
                { "label": "5 Months", "value": "5 Months" },
                { "label": "6 Months", "value": "6 Months" },
                { "label": "7 Months", "value": "7 Months" },
                { "label": "8 Months", "value": "8 Months" },
                { "label": "9 Months", "value": "9 Months" },
                { "label": "1 Year", "value": "1 Year" }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "personalDetails",
      "label": "PERSONAL DETAILS",
      "fields": [
        {
          "type": "group",
          "name": "insuredDetails",
          "label": "",
          "fields": [
            {
              "type": "select",
              "name": "typeOfCustomer",
              "label": "Customer Type",
              "validation": {
                "required": "Customer Type is required"
              },
              "options": [
                { "label": "INDIVIDUAL", "value": "INDIVIDUAL" },
                { "label": "CORPORATE", "value": "CORPORATE" }
              ]
            },
            {
              "type": "text",
              "name": "firstName",
              "label": "First Name",
              "validation": {
                "required": "First Name is required",
                "maxLength": {
                  "value": 50,
                  "message": "Length cannot be more than 50 characters"
                }
              },
              "showWhen": {
                "field": "typeOfCustomer",
                "value": "INDIVIDUAL"
              }
            },
            {
              "type": "text",
              "name": "firstName",
              "label": "Company Name",
              "validation": {
                "required": "Company Name is required",
                "maxLength": {
                  "value": 100,
                  "message": "Length cannot be more than 100 characters"
                }
              },
              "showWhen": {
                "field": "typeOfCustomer",
                "value": "CORPORATE"
              }
            },
            {
              "type": "text",
              "name": "surname",
              "label": "Surname",
              "validation": {
                "required": "Surname is required",
                "maxLength": {
                  "value": 50,
                  "message": "Length cannot be more than 50 characters"
                }
              },
              "showWhen": {
                "field": "typeOfCustomer",
                "value": "INDIVIDUAL"
              }
            },
            {
              "type": "text",
              "name": "address",
              "label": "Address",
              "validation": {
                "required": "Address is required"
              }
            },
            {
              "type": "text",
              "name": "occupation",
              "label": "Occupation / Business",
              "validation": {
                "required": "Occupation or Business required"
              }
            },
            {
              "type": "text",
              "name": "contact",
              "label": "Phone Number",
              "validation": {
                "required": "Phone number is required",
                "pattern": {
                  "value": "^(020|023|024|025|026|027|028|050|053|054|055|056|057|059)\\d{7}$",
                  "message": "Only Valid Ghanaian Phone Number allowed."
                },
                "minLength": {
                  "value": 10,
                  "message": "Minimum 10 digits"
                },
                "maxLength": {
                  "value": 10,
                  "message": "Maximum 10 digits"
                }
              }
            },
            {
              "type": "text",
              "name": "email",
              "label": "Email",
              "validation": {
                "pattern": {
                  "value": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
                  "message": "Invalid email"
                }
              }
            },
            {
              "type": "text",
              "name": "idNumber",
              "label": "Valid National ID No",
              "showWhen": {
                "field": "typeOfCustomer",
                "value": "INDIVIDUAL"
              },
              "validation": {
                "required": "ID Number is required",
                "pattern": {
                  "value": "^[A-Z]{3}-\\d{9}-\\d$",
                  "message": "Ghana card shold be in the format GHA-XXXXXXXXX-X"
                }
              }
            },
            {
              "type": "text",
              "name": "idNumber",
              "label": "Valid TIN No",
              "showWhen": {
                "field": "typeOfCustomer",
                "value": "CORPORATE"
              },
              "validation": {
                "required": "TIN Number is required",
                "pattern": {
                  "value": "^[PCGQV]00[A-Z0-9]{8}$",
                  "message": "Tin Number should be in the format P00XXXXXXXX"
                }
              }
            },
            {
              "type": "text",
              "name": "yearOfEst",
              "label": "Year of Establishment",
              "validation": {
                "required": "Year of Establishment is required",
                "pattern": {
                  "value": "^\\d{4}$",
                  "message": "Should be a year eg. 2005, 1992..."
                }
              },
              "showWhen": {
                "field": "typeOfCustomer",
                "value": "CORPORATE"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "typeOfCover",
      "label": " TYPE OF COVER",
      "fields": [
        {
          "type": "select",
          "name": "coverType",
          "label": "Type of Cover",
          "validation": {
            "required": "Type of cover required"
          },
          "options": [
            { "label": "FIRE", "value": "FIRE" },
            {
              "label": "COMBINED FIRE & BURGLARY",
              "value": "COMBINED FIRE & BURGLARY"
            },
            { "label": "ASSETS ALL RISKS", "value": "ASSETS ALL RISKS" }
          ]
        }
      ]
    },
    {
      "name": "coverDetails",
      "label": "COVER DETAILS",
      "fields": [
        {
          "type": "text",
          "name": "locationAddress",
          "label": "Location Address and nearest Landmark of property to be insured",
          "validation": {
            "required": "Cover is required",
            "maxLength": {
              "value": 120,
              "message": "length should be 120 characters or less"
            }
          }
        },
        {
          "type": "select",
          "name": "natureOfBuilding",
          "label": "Nature of Building",
          "validation": {
            "required": "Nature of building required"
          },
          "options": [
            { "label": "COMMERCIAL", "value": "COMMERCIAL" },
            { "label": "RESIDENTIAL", "value": "RESIDENTIAL" }
          ]
        },
        {
          "type": "text",
          "name": "natureOfOccupation",
          "label": "Nature of occupation engaged in the building (eg. Fcatory, Shop, Offices, Warehouse)",
          "validation": {
            "required": "Required",
            "maxLength": {
              "value": 100,
              "message": "length should be 120 characters or less"
            }
          },
          "showWhen": {
            "field": "natureOfBuilding",
            "value": "COMMERCIAL"
          }
        },
        {
          "type": "info",
          "content": "Construction of Building",
          "variant": "descTb"
        },
        {
          "type": "group",
          "name": "cob",
          "lable": "",
          "fields": [
            {
              "type": "select",
              "name": "constructionType",
              "label": "Construciton Type",
              "validation": {
                "required": "Construction type is required"
              },
              "options": [
                { "label": "CEMENT BLOCKS", "value": "CEMENT BLOCKS" },
                { "label": "CONCRETE", "value": "CONCRETE" },
                { "label": "BRICK STONE", "value": "BRICK STONE" },
                { "label": "OTHERS", "value": "OTHERS" }
              ]
            },
            {
              "type": "text",
              "name": "constructionTypeOther",
              "label": "Construction Type (OTHER)",
              "validation": {
                "required": "required",
                "maxLength": {
                  "value": 100,
                  "message": "Characters should not be more than 100 characters"
                }
              },
              "showWhen": {
                "field": "constructionType",
                "value": "OTHERS"
              }
            },
            {
              "type": "select",
              "name": "typeOfRoofing",
              "label": "Type of Roofing",
              "validation": {
                "required": "Type of roofing is required"
              },
              "options": [
                { "label": "SLATE", "value": "SLATE" },
                { "label": "TILE CONCRETE", "value": "TILE CONCRETE" },
                { "label": "ALUMINIUM", "value": "ALUMINIUM" },
                { "label": "ASBESTOS", "value": "ASBESTOS" },
                { "label": "OTHERS", "value": "OTHERS" }
              ]
            },
            {
              "type": "text",
              "name": "typeOfRoofingOther",
              "label": "Type of Roofing (OTHER)",
              "validation": {
                "required": "required",
                "maxLength": {
                  "value": 100,
                  "message": "Characters should be < than 101"
                }
              },
              "showWhen": {
                "field": "typeOfRoofing",
                "value": "OTHERS"
              }
            },
            {
              "type": "text",
              "name": "descriptionOfBuilding",
              "label": "Description of Building / Property",
              "validation": {
                "required": "Description is required",
                "maxLength": {
                  "value": 80,
                  "message": "Length should be more than 80 characters"
                }
              }
            }
          ]
        },
        {
          "type": "radio",
          "name": "isMultipleTenancy",
          "label": "Is it a multiple-tenancy occupancy or part of a building",
          "validation": {
            "required": "Required"
          },
          "options": [
            { "label": "YES", "value": true },
            { "label": "NO", "value": false }
          ]
        },
        {
          "type": "text",
          "name": "isMultipleTenancyYes",
          "label": "If so, which part of the building do you occupy",
          "validation": {
            "maxLength": {
              "value": 80,
              "message": "length should not be more than 80 characters"
            }
          },
          "showWhen": {
            "field": "isMultipleTenancy",
            "value": "true"
          }
        },
        {
          "type": "text",
          "name": "howLong",
          "label": "For how long have you occupied the premises?",
          "validation": {
            "required": "Required",
            "maxLength": {
              "value": 80,
              "message": "Length should not be more than 80"
            }
          }
        },
        {
          "type": "text",
          "name": "securitySystems",
          "label": "What security systems are put in place to ensure the safety of the property being proposed for insurance?",
          "validation": {
            "required": "Required",
            "maxLength": {
              "value": 100,
              "message": "Length should not be more than 100 characters"
            }
          }
        },
        {
          "type": "group",
          "name": "premisInstall",
          "label": "",
          "fields": [
            {
              "type": "radio",
              "name": "fireInstalled",
              "label": "Is your premises installed with fire extinguishing appliances",
              "validation": {
                "required": "Required"
              },
              "options": [
                { "label": "YES", "value": true },
                { "label": "NO", "value": false }
              ]
            },
            {
              "type": "radio",
              "name": "smokeInstalled",
              "label": "Are smoke detectors installed at your premises?",
              "validation": {
                "required": "Required"
              },
              "options": [
                { "label": "YES", "value": true },
                { "label": "NO", "value": false }
              ]
            },
            {
              "type": "radio",
              "name": "alarmInstalled",
              "label": "Is there an intruder alarm?",
              "validation": {
                "required": "Required"
              },
              "options": [
                { "label": "YES", "value": true },
                { "label": "NO", "value": false }
              ]
            },
            {
              "type": "radio",
              "name": "exposedFlooding",
              "label": "Is the premises exposed to flooding?",
              "validation": {
                "required": "Required"
              },
              "options": [
                { "label": "YES", "value": true },
                { "label": "NO", "value": false }
              ]
            }
          ]
        },
        {
          "type": "group",
          "name": "eight",
          "label": "",
          "fields": [
            {
              "type": "radio",
              "name": "engageIn",
              "label": "Do you engage in any process of manufacture or any hazardous activity?",
              "options": [
                { "label": "YES", "value": true },
                { "label": "NO", "value": false }
              ]
            },
            {
              "type": "text",
              "name": "engageInYes",
              "label": "If so, gice details:",
              "validation": {
                "required": "Required",
                "maxLength": {
                  "value": 100,
                  "message": "Length should not be more than 100 characters"
                }
              },
              "showWhen": {
                "field": "engageIn",
                "value": "true"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "insuranceHistory",
      "label": "INSURANCE HISTORY",
      "fields": [
        {
          "type": "radio",
          "name": "sufferedLoss",
          "label": "Have you ever suffered any loss or damage by Fire or Burglary during the past three years?",
          "validation": {
            "required": "Required"
          },
          "options": [
            { "label": "YES", "value": true },
            { "label": "NO", "value": false }
          ]
        },
        {
          "type": "text",
          "name": "sufferedLossYes",
          "label": "If so, give details:",
          "validation": {
            "required": "Required",
            "maxLength": {
              "value": 100,
              "message": "Length should be less than 100"
            }
          },
          "showWhen": {
            "field": "sufferedLoss",
            "value": "true"
          }
        },
        {
          "type": "radio",
          "name": "hasAnyClaim",
          "label": "Has any claim been made against you during the past three years by any person for damage to their property or personal injureis?",
          "validation": {
            "required": "Required"
          },
          "options": [
            { "label": "YES", "value": true },
            { "label": "NO", "value": false }
          ]
        },
        {
          "type": "text",
          "name": "hasAnyClaimYes",
          "label": "If so, give details:",
          "validation": {
            "required": "Required",
            "maxLength": {
              "value": 100,
              "message": "Length should be less than 100"
            }
          },
          "showWhen": {
            "field": "hasAnyClaim",
            "value": "true"
          }
        },
        {
          "type": "radio",
          "name": "insuranceRefused",
          "label": "Has any Insurance Company ever refused/declined your proposal, increased your premium at renewal, cancelled or refused to renew your policy?",
          "validation": {
            "required": "Required"
          },
          "options": [
            { "label": "YES", "value": true },
            { "label": "NO", "value": false }
          ]
        },
        {
          "type": "radio",
          "name": "propertyProposed",
          "label": "Is the property proposed for insurance already insured with another Company?",
          "validation": {
            "required": "Required"
          },
          "options": [
            { "label": "YES", "value": true },
            { "label": "NO", "value": false }
          ]
        },
        {
          "type": "radio",
          "name": "otherInsurancePolicy",
          "label": "Do you have any other Insurance policy here or elsewhere?",
          "validation": {
            "required": "Required"
          },
          "options": [
            { "label": "YES", "value": true },
            { "label": "NO", "value": false }
          ]
        },
        {
          "type": "text",
          "name": "otherInsurancePolicyYes",
          "label": "If so, state type:",
          "validation": {
            "required": "Required",
            "maxLength": {
              "value": 100,
              "message": "Length should be less than 100"
            }
          },
          "showWhen": {
            "field": "otherInsurancePolicy",
            "value": "true"
          }
        }
      ]
    },
    {
      "name": "propertyDetails",
      "label": "PROPERTY DETAILS",
      "fields": [
        {
          "type": "staticTable",
          "name": "contents",
          "label": "",
          "columns": [
            "Description of Property",
            "Value",
            "Additional Information"
          ],
          "fields": [
            { "key": "amount", "type": "number", "placeholder": "0.00" },
            { "key": "desc", "type": "text", "placeholder": "Additional Info" }
          ],
          "rows": [
            {
              "label": "Building",
              "value": "building",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": ["COMMERCIAL", "RESIDENTIAL"]
              }
            },
            {
              "label": "Wall, Fences & Gates",
              "value": "wall",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": "COMMERCIAL"
              }
            },
            {
              "label": "Office Equipment",
              "value": "office",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": "COMMERCIAL"
              }
            },
            {
              "label": "Furniture, Fixtures & Fittings",
              "value": "furniture",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": "COMMERCIAL"
              }
            },
            {
              "label": "Stock-in-Trade / Finished goods",
              "value": "stockInTrade",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": "COMMERCIAL"
              }
            },
            {
              "label": "Stock of Raw Materials/Work-in-Progress",
              "value": "stockOfRaw",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": "COMMERCIAL"
              }
            },
            {
              "label": "Plant & Machinery",
              "value": "plant",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": "COMMERCIAL"
              }
            },
            {
              "label": "Goods held in Trust or Commission",
              "value": "goodsHeld",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": "COMMERCIAL"
              }
            },
            {
              "label": "Personal Effect & Content",
              "value": "personalEffect",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": "RESIDENTIAL"
              }
            },
            {
              "label": "Art Works",
              "value": "artWorks",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": "RESIDENTIAL"
              }
            },
            {
              "label": "Jewelery",
              "value": "jewelery",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": "RESIDENTIAL"
              }
            },
            {
              "label": "Any Other Propoerties to be Insured",
              "value": "anyOther",
              "showWhen": {
                "field": "$root.coverDetails.natureOfBuilding",
                "value": ["RESIDENTIAL", "COMMERCIAL"]
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "mortgage",
          "label": "Name and Address of Mortgage, if Any?",
          "validation": {
            "maxLength": {
              "value": 100,
              "message": "Length should not be above 100 characters"
            }
          }
        },
        {
          "type": "multiSelectTable",
          "name": "extend",
          "label": "Please indicate extension(s) / Add-on-cover required",
          "options": [
            { "label": "TEMPORARY REMOVAL", "value": "Temporary Removal" },
            { "label": "CAPITAL ADDITIONS", "value": "Capital Additions" },
            { "label": "DEBIS REMOVAL", "value": "Debris Removal" },
            { "label": "PROFESSIONAL FEES", "value": "Professional Fees" },
            {
              "label": "CARE CUSTODY & CONTROL",
              "value": "CARE Custody & Control"
            },
            {
              "label": "REINSTATEMENT CONDITION",
              "value": "Reinstatement Condition"
            }
          ]
        }
      ]
    },
    {
      "name": "declaration",
      "label": "DECLARATION",
      "fields": [
        {
          "type": "info",
          "content": "I / We warrant that all the statements made above are true and that I / We have not with-held or noncealed anything affecting the proposal. I / We also agree that this proposal shall be the basis of the Contract.",
          "variant": "decText"
        },
        {
          "type": "radio",
          "name": "declaration",
          "label": "",
          "validation": {
            "required": "Required"
          },
          "options": [{ "label": "I Accept", "value": true }]
        },
        {
          "type": "info",
          "content": "I consent to NSIA Insurance Company Limited contacting me via phone, email, or SMS to share information about other insurance products, tailored offers, and services that may benefit me. I understand I can opt out at any time.",
          "variant": "decText"
        },
        {
          "type": "radio",
          "name": "concent",
          "label": "",
          "validation": {
            "required": "Required"
          },
          "options": [
            { "label": "YES", "value": "true" },
            { "label": "NO", "value": "false" }
          ]
        },
        {
          "type": "signature",
          "name": "signature",
          "label": "Applicant's Signature"
        }
      ]
    }
  ]
}
